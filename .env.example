# Local Docker development only. Generate real secrets for deployment.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=local-only-replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
POSTGRES_DB=elvaa
POSTGRES_USER=elvaa
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
USE_SQLITE=False
# Explicitly opt in for unpaid demo orders; never enable on a live store.
ALLOW_DEMO_CHECKOUT=False
# Optional hosted Stripe checkout. Leave blank until test credentials and webhook are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
